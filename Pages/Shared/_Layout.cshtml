@{
    var currentPage = ViewData["Title"]?.ToString();
    var feedbackMessage = TempData["Feedback"] as string;
    var hasFeedbackMessage = !string.IsNullOrWhiteSpace(feedbackMessage);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aplicativo de gerenciamento de tarefas, desenvovido com Asp.net Core Razor Pages">
    <title>@ViewData["Title"] - TaskList</title>
    <script>
        (() => {
            let storedTheme = null;
            try {
                storedTheme = localStorage.getItem("taskflow-theme");
            } catch {
                storedTheme = null;
            }
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = storedTheme ?? (prefersDark ? "dark" : "light");
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(hasFeedbackMessage ? "has-toast" : string.Empty)">
    <header class="app-header">
        <a class="brand" asp-page="/Index" aria-label="TaskList inicio">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>TaskList</span>
        </a>

        <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Abrir menu" data-menu-toggle>
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="app-nav" id="primary-navigation" aria-label="Principal" data-menu>
            <a class="@(currentPage == "Dashboard" ? "is-active" : string.Empty)" asp-page="/Index">Dashboard</a>
            <a class="@(currentPage == "Tarefas" ? "is-active" : string.Empty)" asp-page="/Tasks/Index">Tarefas</a>
            <a class="button button-primary button-small" asp-page="/Tasks/Create">Nova tarefa <span aria-hidden="true">+</span></a>
        </nav>
    </header>

    <main class="app-shell" role="main">
        @if (hasFeedbackMessage)
        {
            <div class="toast-message" role="status" data-toast>@feedbackMessage</div>
        }

        @RenderBody()
    </main>

    <footer class="app-footer">
        <p>&copy; 2026 TaskFlow. Todos os direitos reservados.</p>
        <nav aria-label="Links do rodape">
            <a asp-page="/Index">Ajuda</a>
            <a asp-page="/Tasks/Index">Atalhos</a>
            <a asp-page="/Index">Privacidade</a>
            <a asp-page="/Index">Termos de uso</a>
        </nav>
    </footer>

    <button class="theme-toggle" type="button" aria-label="Alternar para tema escuro" title="Alternar tema" data-theme-toggle>
        <span class="theme-toggle-icon" aria-hidden="true"></span>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Editar tarefa";
}

<section class="page-heading compact">
    <p class="eyebrow">Editar tarefa</p>
    <h1>Ajuste o plano antes do próximo movimento.</h1>
</section>

<section class="panel form-panel">
    <form method="post" class="task-form">
        <partial name="_TaskForm" for="Input" />

        <div class="form-actions">
            <a class="button button-ghost" asp-page="/Index">Cancelar</a>
            <button class="button button-primary" type="submit">Salvar alterações</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
